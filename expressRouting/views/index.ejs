<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Express Routing App</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="nav-brand">Express Routing</a>
      <ul class="nav-menu">
        <li class="nav-item">
          <a href="/" class="nav-link active">Home</a>
        </li>
        <li class="nav-item">
          <a href="/services" class="nav-link">Our Services</a>
        </li>
        <li class="nav-item">
          <a href="/contact" class="nav-link">Contact Us</a>
        </li>
      </ul>
    </div>
  </nav>

  <main class="container">
    <section class="hero">
      <h1>Welcome to Our Express Routing Application</h1>
      <p>Explore our services and get in touch with us</p>
    </section>

    <section class="content">
      <h2>About Us</h2>
      <p>We are a company dedicated to providing quality services during business hours. 
      This application was built using Express.js and demonstrates routing, middleware, 
      and server-side rendering with EJS templates.</p>
      
      <div class="features">
        <div class="feature-card">
          <h3>🚀 Fast</h3>
          <p>Built with Express.js for high-performance routing</p>
        </div>
        <div class="feature-card">
          <h3>🎨 Beautiful</h3>
          <p>Responsive design with modern CSS styling</p>
        </div>
        <div class="feature-card">
          <h3>⏰ Working Hours</h3>
          <p>Available Monday to Friday, 9 AM - 5 PM</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <p>&copy; 2026 Express Routing Application. All rights reserved.</p>
  </footer>
</body>
</html>
